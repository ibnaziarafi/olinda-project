{
  "version": 2,
  "name": "olinda-frontend",
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/", "destination": "/dashboard/test_website.html" },
    { "source": "/index.html", "destination": "/dashboard/test_website.html" },
    { "source": "/test_website.html", "destination": "/dashboard/test_website.html" },
    { "source": "/dashboard", "destination": "/dashboard/dashboard.html" },
    { "source": "/dashboard.html", "destination": "/dashboard/dashboard.html" },
    { "source": "/dashboard.css", "destination": "/dashboard/styles/dashboard.css" },
    { "source": "/scripts/:path*", "destination": "/dashboard/scripts/:path*" },
    { "source": "/widget.js", "destination": "/chatbot/widget.js" },
    { "source": "/widget.css", "destination": "/chatbot/ui/widget.css" },
    { "source": "/js/:path*", "destination": "/chatbot/js/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
