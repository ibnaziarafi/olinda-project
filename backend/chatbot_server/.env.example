# Copy to .env inside this server folder for local development.
# Set production secrets through your hosting environment, never commit real keys.
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
GROQ_API_KEY=
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
FORWARDED_ALLOW_IPS=
MAX_CONCURRENT_REQUESTS=8
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.6-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768
CONFIDENCE_THRESHOLD=0.65
RAG_TOP_K=3
MAX_HISTORY_MESSAGES=8
MAX_RECENT_MESSAGES=4
MAX_SUMMARY_TOKENS=400
OLINDA_DB_PATH=olinda.db

# Keep unanswered questions for staff to add official answers.
UNANSWERED_LOG_ENABLED=true
# Shared daily chat cap; 0 pauses chat. Resets at 00:00 UTC.
CHAT_DAILY_REQUEST_LIMIT=200
CHAT_REQUESTS_PER_MINUTE=15
