# Copy this file to ".env" and fill in your real keys there.
# ".env" is listed in .gitignore — never commit your real keys to GitHub.

# The answering model — Qwen 3.6 27B via Groq.
# Get a free key at https://console.groq.com/keys — no credit card needed.
GROQ_API_KEY=your_groq_api_key_here

# Used only for embeddings (turning text into vectors for search).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL + pgvector (optional — falls back to local SQLite if not set).
# Find these in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# Optional tuning — defaults shown
GROQ_MODEL=qwen/qwen3.6-27b
GEMINI_MODEL=gemini-3.6-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768
CONFIDENCE_THRESHOLD=0.65
TOP_K=4
RAG_TOP_K=3
MAX_HISTORY_MESSAGES=8
MAX_RECENT_MESSAGES=4
MAX_SUMMARY_TOKENS=400
OLINDA_DB_PATH=olinda.db
