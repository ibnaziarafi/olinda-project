# Copy to .env inside this server folder for local development.
# Set production secrets through your hosting environment, never commit real keys.
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
STAFF_USERS=
TOKEN_TTL_SECONDS=3600
FORWARDED_ALLOW_IPS=
MAX_CONCURRENT_REQUESTS=8
EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768
OLINDA_DB_PATH=olinda.db

